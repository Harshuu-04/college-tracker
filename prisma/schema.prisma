generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}







enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum SubmissionStatus {
  SUBMITTED
  NOT_SUBMITTED
}

enum ExamType {
  MID_SEM
  END_SEM
}

enum PlacementStatus {
  NOT_PLACED
  PLACED
  INTERN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  createdAt DateTime @default(now())

  teacher Teacher?
  student Student?
}

model Teacher {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  subjects       Subject[]
  proctorOfClass Class[]        @relation("ProctorClass")
  attendanceLogs Attendance[]
  assignments    Assignment[]
}

model Class {
  id   String @id @default(cuid())
  name String // e.g. "CSE 3rd Year - A"

  proctorId String?
  proctor   Teacher? @relation("ProctorClass", fields: [proctorId], references: [id])

  students Student[]
  subjects Subject[]
}

model Student {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])
  rollNo    String @unique
  classId   String
  class     Class  @relation(fields: [classId], references: [id])

  attendance  Attendance[]
  submissions Submission[]
  marks       Marks[]
  placement   Placement?
}

model Subject {
  id      String @id @default(cuid())
  name    String
  classId String
  class   Class  @relation(fields: [classId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  attendance  Attendance[]
  assignments Assignment[]
  marks       Marks[]
}

model Attendance {
  id        String           @id @default(cuid())
  date      DateTime
  status    AttendanceStatus
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  subjectId String
  subject   Subject          @relation(fields: [subjectId], references: [id])
  teacherId String
  teacher   Teacher          @relation(fields: [teacherId], references: [id])

  @@unique([studentId, subjectId, date])
}

model Assignment {
  id        String   @id @default(cuid())
  title     String
  dueDate   DateTime
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])

  submissions Submission[]
}

model Submission {
  id           String            @id @default(cuid())
  assignmentId String
  assignment   Assignment        @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      Student           @relation(fields: [studentId], references: [id])
  status       SubmissionStatus  @default(NOT_SUBMITTED)

  @@unique([assignmentId, studentId])
}

model Marks {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  examType  ExamType
  score     Float
  maxScore  Float
}

model Placement {
  id        String          @id @default(cuid())
  studentId String          @unique
  student   Student         @relation(fields: [studentId], references: [id])
  status    PlacementStatus @default(NOT_PLACED)
  company   String?
  role      String?
}