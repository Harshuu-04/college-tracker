generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}







enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum PlacementStatus {
  NOT_PLACED
  PLACED
  INTERN
}

enum DriveType {
  FULL_TIME
  INTERNSHIP
}

enum RoundStatus {
  PENDING
  CLEARED
  REJECTED
}

model Drive {
  id                   String    @id @default(cuid())
  companyName          String
  role                 String
  type                 DriveType
  packageLPA           Float?
  description          String?   @db.Text
  driveDate            DateTime?
  registrationDeadline DateTime
  minCgpa              Float?
  maxBacklogs          Int?
  createdAt            DateTime  @default(now())

  eligibleClasses DriveEligibleClass[]
  rounds          DriveRound[]
  registrations   DriveRegistration[]
}

model DriveEligibleClass {
  id      String @id @default(cuid())
  driveId String
  drive   Drive  @relation(fields: [driveId], references: [id])
  classId String
  class   Class  @relation(fields: [classId], references: [id])

  @@unique([driveId, classId])
}

model DriveRound {
  id      String @id @default(cuid())
  driveId String
  drive   Drive  @relation(fields: [driveId], references: [id])
  name    String
  order   Int

  results RoundResult[]
}

model DriveRegistration {
  id           String   @id @default(cuid())
  driveId      String
  drive        Drive    @relation(fields: [driveId], references: [id])
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  registeredAt DateTime @default(now())

  @@unique([driveId, studentId])
}

model RoundResult {
  id        String      @id @default(cuid())
  roundId   String
  round     DriveRound  @relation(fields: [roundId], references: [id])
  studentId String
  student   Student     @relation(fields: [studentId], references: [id])
  status    RoundStatus @default(PENDING)

  @@unique([roundId, studentId])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  createdAt DateTime @default(now())

  teacher Teacher?
  student Student?
}

model Teacher {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  proctorOfClass Class[] @relation("ProctorClass")
}

model Class {
  id    String @id @default(cuid())
  name  String
  year  Int?
  batch String?

  proctorId String?
  proctor   Teacher? @relation("ProctorClass", fields: [proctorId], references: [id])

  students        Student[]
  driveEligibility DriveEligibleClass[]
}

model Student {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])
  rollNo    String @unique
  classId   String
  class     Class  @relation(fields: [classId], references: [id])

  cgpa          Float?
  backlogs      Int?    @default(0)
  techStack     String?
  resumeUrl     String?
  profilePicUrl String?
  targetRole    String?
  targetDomain  String?
  githubUrl     String?
  leetcodeUrl   String?
  gfgUrl        String?
  linkedinUrl   String?
  projects      String? @db.Text

  placement     Placement?
  registrations DriveRegistration[]
  roundResults  RoundResult[]
}

model Placement {
  id            String          @id @default(cuid())
  studentId     String          @unique
  student       Student         @relation(fields: [studentId], references: [id])
  status        PlacementStatus @default(NOT_PLACED)
  company       String?
  role          String?
  packageLPA    Float?
  offerLetterUrl String?
}