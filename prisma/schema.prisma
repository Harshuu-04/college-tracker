generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}







enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum PlacementStatus {
  NOT_PLACED
  PLACED
  INTERN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  createdAt DateTime @default(now())

  teacher Teacher?
  student Student?
}

model Teacher {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  proctorOfClass Class[] @relation("ProctorClass")
}

model Class {
  id    String @id @default(cuid())
  name  String
  year  Int?
  batch String?

  proctorId String?
  proctor   Teacher? @relation("ProctorClass", fields: [proctorId], references: [id])

  students Student[]
}

model Student {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])
  rollNo    String @unique
  classId   String
  class     Class  @relation(fields: [classId], references: [id])

  cgpa          Float?
  techStack     String?
  resumeUrl     String?
  profilePicUrl String?
  targetRole    String?
  targetDomain  String?
  githubUrl     String?
  leetcodeUrl   String?
  gfgUrl        String?
  linkedinUrl   String?
  projects      String? @db.Text

  placement Placement?
}

model Placement {
  id            String          @id @default(cuid())
  studentId     String          @unique
  student       Student         @relation(fields: [studentId], references: [id])
  status        PlacementStatus @default(NOT_PLACED)
  company       String?
  role          String?
  packageLPA    Float?
  offerLetterUrl String?
}